Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 30
    - Class: rviz/Path
      Name: VINS Trajectory
      Enabled: true
      Topic: /vins_estimator/path
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.04
      Buffer Length: 1
    - Class: rviz/PointCloud2
      Name: Full VINS Map (Unlimited)
      Enabled: true
      Topic: /vins_estimator/full_map
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Axis: Z
      Autocompute Value Bounds: true
      Use Fixed Frame: true
    - Class: rviz/Image
      Name: IR1 Feature Tracking
      Enabled: true
      Image Topic: /feature_tracker/feature_img
      Queue Size: 2
      Transport Hint: raw
      Normalize Range: true
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
